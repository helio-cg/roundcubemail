DEPLOY_TARGET=root@mail.exemplo.com

DEPLOY_SUDO=sudo -n

RC_ROOT=/var/lib/roundcube
RC_CONFIG_DIR=/etc/roundcube
RC_OWNER=hestiamail:www-data

RC_SKIN=carius
RC_SKINS="carius iguatu canga"
RC_PLUGINS="calendar libcalendaring libkolab twofactor_gauthenticator user"

RC_VERSION_PREFIX=1.7.
RC_ALLOW_VERSION_MISMATCH=0

RC_INSTALL_COMPOSER_DEPS=1

RC_BACKUP_DIR=/root/roundcube-deploy-backups
RC_KEEP_BACKUPS=5
RC_ROLLBACK_ON_FAILURE=1

RC_HEALTH_URL=https://webmail.exemplo.com/

# Spamhaus com resolvedor recursivo local (unbound) no servidor.
# 1 = instala/configura o unbound, aponta /etc/resolv.conf para ele e reativa
#     o zen.spamhaus.org no Exim (Hestia). O script valida o Spamhaus antes de
#     tocar no Exim e reverte tudo sozinho se algo falhar.
# 0 = não mexe em DNS/Exim.
RC_SPAMHAUS_UNBOUND=1
RC_SPAMHAUS_DNSBL=zen.spamhaus.org

# TLS no acesso local do Roundcube ao Dovecot (993) e ao Exim (587).
# 1 = imap_host ssl://localhost:993 e smtp_host tls://localhost:587, com
#     verificação de certificado relaxada apenas no loopback (o certificado
#     é emitido para o nome público, não para "localhost").
# 0 = mantém o que o config.inc.php do painel já define.
RC_LOCAL_TLS=1


# Instala as ferramentas de backup/restauração por usuário da Hestia em
# /usr/local/lib/roundcube-backup e os comandos rc-backup/rc-restore/rc-backup-verify.
# A configuração do R2 fica em /etc/roundcube/rc-backup.env (criada a partir do exemplo).
RC_INSTALL_BACKUP_TOOLS=1

# R2/rclone no primeiro deploy.
# Se /etc/roundcube/rc-backup.env já tiver as chaves do R2, o deploy não
# pergunta nada e segue com a atualização normal.
# Para automação, informe os dados por variáveis (o arquivo é gitignored):
#RC_R2_ACCOUNT_ID=SEU_ACCOUNT_ID
#RC_R2_ACCESS_KEY_ID=...
#RC_R2_SECRET_ACCESS_KEY=...
#RC_R2_BUCKET=roundcube-backups
#RC_R2_PREFIX=roundcube-backups
# Em vez de Account ID você pode informar a URL completa:
#RC_R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# auto = pergunta só se ainda não houver chaves; 1 = reconfigurar; 0 = ignorar
#RC_CONFIGURE_R2=auto
# ask = pergunta antes de instalar o rclone; 1 = instalar; 0 = falhar
#RC_INSTALL_RCLONE=ask
# 1 = não configurar o R2 neste deploy (o backup ficará sem funcionar)
#RC_R2_SKIP_SETUP=0
#RC_BACKUP_ENV_FILE=/etc/roundcube/rc-backup.env
