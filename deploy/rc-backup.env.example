# Configuração do backup/restauração Roundcube por usuário da Hestia.
# Normalmente este arquivo é gerado pelo deploy no primeiro uso; use este
# exemplo apenas para configurar manualmente.
# Copie para /etc/roundcube/rc-backup.env e ajuste. Mantenha 600 root:root.

# Backend do R2:
#   rclone  -> recomendado; configure o remote abaixo ou via variáveis RCLONE_CONFIG_*
#   aws     -> awscli com endpoint do R2
#   local   -> diretório local (útil para testes)
RC_R2_BACKEND=rclone

# rclone: remote configurado no rclone.conf
RC_R2_REMOTE=r2
RC_R2_BUCKET=roundcube-backups
RC_R2_PREFIX=roundcube-backups

# aws (quando RC_R2_BACKEND=aws)
#RC_R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# local (quando RC_R2_BACKEND=local)
#RC_R2_LOCAL_DIR=/var/backups/roundcube-r2

# Retenção por usuário da Hestia
RC_RETENTION_COUNT=14
RC_RETENTION_DAYS=90

# Confere checksum e tamanho no remoto logo após o envio
RC_VERIFY_AFTER_UPLOAD=1

# Caminhos no servidor
RC_CONFIG=/etc/roundcube/config.inc.php
HESTIA_BIN=/usr/local/hestia/bin
PHP_BIN=php
RC_LOCK_FILE=/run/rc-roundcube-backup.lock
RC_LOG_FILE=/var/log/rc-roundcube-backup.log

# Para testes locais (sem Hestia): descomente e aponte para um SQLite/MySQL
#RC_DB_DSN=sqlite:////var/roundcube/db/sqlite.db
#RC_DATA_PHP=/usr/local/lib/roundcube-backup/rc-data.php

# rclone sem arquivo de configuração (credenciais do R2):
#RCLONE_CONFIG_R2_TYPE=s3
#RCLONE_CONFIG_R2_PROVIDER=Cloudflare
#RCLONE_CONFIG_R2_ACCESS_KEY_ID=...
#RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=...
#RCLONE_CONFIG_R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
#RCLONE_CONFIG_R2_REGION=auto
